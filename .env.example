# Proof Market Maker — runtime config (copy to .env, fill secrets locally)
# Paper-trading / devnet wallet. NEVER commit the real .env.
PROOF_PRIVATE_KEY=
PROOF_ADDRESS=
PROOF_GATEWAY_URL=https://api.dev.proof.trade
PROOF_CHAIN_ID=exchange-devnet-1
LOG_LEVEL=info

# Discovered during ELO-8 spike (NOT defaults shipped by the SDK):
# WS endpoint: wss://api.dev.proof.trade/ws  (single multiplexed socket)
# Subscribe:   {"method":"subscribe","params":{"channel":"orderbook","market":<id>}}

# ELO-13 dashboard publishing (optional — bot runs normally if unset).
# URL + anon key are PUBLIC. BOT_PUBLISH_SECRET is the shared secret the bot
# presents to the `dashboard-rpc` Edge Function for privileged writes; keep it in
# .env only (out-of-band, like PROOF_PRIVATE_KEY). The Supabase service-role key
# is NEVER placed here — it lives inside the Edge Function on Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BOT_PUBLISH_SECRET=
